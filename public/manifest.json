{
  "manifest_version": 3,
  "name": "SaveToBuy",
  "version": "0.1.0",
  "description": "Save clothing products into one unified closet.",
  "action": {
    "default_title": "SaveToBuy",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/serviceWorker.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
